{
    "name": "stevenpaw/furdentity",
    "type": "silverstripe-recipe",
    "description": "A tool for connecting different furry identity pages of all types together into one",
    "version": "0.1.0",
    "repositories": [
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "silverstripe/recipe-core": "^6.2",
        "silverstripe/admin": "^3.2",
        "silverstripe/asset-admin": "^3.2",
        "stevenpaw/silverstripe-cms-backend-theme": "^1.1",
        "firebase/php-jwt": "^7.1",
        "silverstripe/login-forms": "^6.2"
    },
    "require-dev": {
        "wernerkrauss/silverstripe-rector": "^1",
        "cambis/silverstan": "^2",
        "squizlabs/php_codesniffer": "^3",
        "phpstan/extension-installer": "^1.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "extra": {
        "resources-dir": "_resources",
        "project-files-installed": [
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "lint": "vendor/bin/phpcs",
        "fix": "vendor/bin/phpcbf",
        "rector": "vendor/bin/rector -v",
        "rector-dry": "vendor/bin/rector -v --dry-run",
        "phpstan": "vendor/bin/phpstan"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
