# For a complete list of core environment variables see
# https://docs.silverstripe.org/en/6/getting_started/environment_management/#core-environment-variables

# DB credentials
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="db"
SS_DATABASE_USERNAME="db"
SS_DATABASE_PASSWORD="db"
SS_DATABASE_NAME="db"
SS_DATABASE_PORT="3306"

# WARNING: in a live environment, change this to "live" instead of dev
SS_ENVIRONMENT_TYPE="dev"

# Default CMS admin for this environment
SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD="password"

# Only necessary on live servers for images
#SS_BASE_URL="https://furdentity.ddev.site"

MAILER_DSN="smtp://localhost:1025"

# --- APIs ---------------------------------------------------------------------
# Public API: comma separated list of accepted X-Api-Key values.
# Leave empty to keep the public API open (local development only).
API_PUBLIC_KEYS=""

# Internal API: secret used to sign JWTs. Set a long random value.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
JWT_SIGNING_KEY=""

# Vite dev server (informational)
VITE_DEV_SERVER_URL="https://furdentity.ddev.site:5173"
